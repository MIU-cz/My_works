{block bodyClass}hp{/block}

{block content}

{* --- 1. EXTRÉMNÍ FILTR: SCHOVÁ VŠECHNO STARÉ --- *}
<style>
    /* 1. Nejdřív skryjeme úplně všechny sekce a divy v hlavním obsahu */
    main section, 
    main div.container-fluid, 
    section#introduction, 
    section#nabidka, 
    .stats, 
    .container > .row.mb-4 { 
        display: none !important; 
    }

    /* 2. Teď "rozsvítíme" pouze naše tři nové sekce */
    section#aktuality-figma, 
    section#about, 
    section#moje-sluzby { 
        display: block !important; 
    }

    /* 3. Zajistíme, aby vnitřní prvky našich sekcí (řady, kontejnery) byly vidět */
    #aktuality-figma .container, 
    #about .row, 
    #moje-sluzby .container,
    #moje-sluzby .row { 
        display: block !important; 
    }
    
    #aktuality-figma .row, 
    #moje-sluzby .row { 
        display: flex !important; 
    }
</style>

{* --- 2. NOVÉ AKTUÁLNĚ (MIU: DYNAMICKÉ ПО URL) --- *}
<section id="aktuality-figma">
    <div class="container text-center">
        <h2 class="section-title">aktuálně</h2>
        
        <div class="news-slider-wrapper">
            {foreach $newsArticles as $article}
                <div class="row align-items-stretch news-slide {if $iterator->first}active{/if}">
                    <div class="col-md-8 d-flex flex-column justify-content-start align-items-start text-start">
                        <div class="news-content-box">
                            <span class="news-date">{$article->date|date:'d/m/y'}</span>
                            <div class="news-divider"></div>
                            <h2 class="news-title">{$article->title}</h2>
                            <p class="news-text">{$article->text|striptags|truncate:250}</p>
                        </div>

                        <div class="news-controls mt-auto">
                            <div class="prev-news">←</div>
                            <div class="next-news">→</div>
                        </div>
                    </div>

                    <div class="col-md-4 d-none d-md-flex align-items-center justify-content-end">
                        <div style="width: 100%; max-width: 400px; aspect-ratio: 1/1;">
                            <img src="img/news/{$article->url}.{$article->image_extension}" 
                                onerror="this.onerror=null; this.src='img/news/01.jpg';"
                                class="w-100 h-100 rounded-circle object-fit-cover shadow"
                                style="object-fit: cover;"> {* Дублируем стилем для надежности *}
                        </div>
                    </div>
                </div>
            {/foreach}
        </div>
    </div>
</section>


{* --- 3. SEKCE O FIRMĚ --- *}
<section id="about" style="position: relative; z-index: 1000; background: white; border-top: 1px solid #eee;">
    <div class="row row-cols-1 row-cols-sm-2 g-0 content">
        <div class="col">
            <img src="{='ABOUT_COMPANY'|imagePath}" alt="CEI" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div class="col text-block-wrapper" style="padding: 60px; background: white;">
            <div class="text-block">
                <h3 style="color: #003366; font-size: 2.8rem; margin-bottom: 25px;">{='ABOUT_COMPANY'|text|noescape}</h3>
                <div style="color: #666; line-height: 1.8; margin-bottom: 35px;">
                    {='ABOUT_COMPANY_TEXT'|text|noescape}
                </div>
                <a class="btn btn-default" n:href="aboutUs" style="padding: 12px 35px; border: 2px solid #003366; color: #003366; font-weight: bold; text-decoration: none;">{='FIND_OUT_MORE'|text|noescape}</a>
            </div>
        </div>
    </div>
</section>

{* --- 4. MOJE NOVÉ IKONY SLUŽEB --- *}
<section id="moje-sluzby" style="padding: 100px 0; background: #f8f8f8; position: relative; z-index: 1000;">
    <div class="container text-center">
        <h2 style="margin-bottom: 60px; color: #333; font-weight: 200; font-size: 3rem;">{='HOMEPAGE_TITLE'|text|lower|noescape}</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-5 justify-content-center">
            <div class="col">
                <a n:href="Homepage:services#service-37" style="text-decoration: none; color: inherit;">
