<!DOCTYPE html> 
<html lang="{$language}">
    <head>
        <meta charset="utf-8">
        <title>{ifset $title}{$title|stripHtml} | {elseifset title}{include title|stripHtml} | {/ifset}{='SITE_NAME'|text|noescape}</title>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="index, follow">
        <meta name="description" content="{ifset description}{include description|stripHtml}{/ifset}">
        <meta n:if="isset($meta) && $meta->og_type" property=”og:type” content="{$meta->og_type}">
        <meta n:if="isset($meta) && $meta->og_title" property="og:title" content="{$meta->og_title}">
        <meta n:if="isset($meta) && $meta->og_description" property="og:description" content="{$meta->og_description}">
        <meta n:if="isset($meta) && isset($meta->og_image) && $meta->og_image" property="og:image" content="https://www.cei.cz/{$meta->og_image}">
        <base href="{$basePath}">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <link rel="stylesheet" href="{='css/style.css'|autoVersion}">
        <link rel="stylesheet" href="{='css/cookieconsent.css'|autoVersion}">
        <link rel="stylesheet" href="{='css/default.css'|autoVersion}">
        <link rel="stylesheet" href="{='css/print.css'|autoVersion}" media="print">

        <!-- MIU -->
        <link rel="stylesheet" href="{$basePath}/css/news-slider.css"> 

        <link rel="icon" type="image/svg+xml" href="{='img/favicon/favicon.svg'|autoVersion}">
        <link rel="icon" type="image/png" href="{='img/favicon/favicon.png'|autoVersion}">
        
        <!-- Google Tag Manager -->
        <script n:syntax="off">
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})
            (window,document,'script','dataLayer','GTM-W7TL29G');
        </script>
        <!-- End Google Tag Manager -->
    </head>
    <body class="{block bodyClass}sp{/block} page-{$presenter->action}">
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W7TL29G" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        <div id="wrapper">
            <span id="top"></span>

            <header id="header" class="container-fluid">
                <div id="navbar">
                    <div class="row g-0">
                        <div class="col d-flex justify-content-between">
                            <a class="logo" n:href="Homepage:default"><img src="{='img/logo.svg'|autoVersion}" alt="GUTRA - logo"></a>
                            <a class="logo2"><img src="{='img/logo-likvidace.svg'|autoVersion}" alt="likvidace odpadu - logo"></a>
                        </div>
                    </div>
                    <div class="row g-0">
                        <nav class="col">
                            <ul id="main-menu">
                                <li n:class="$presenter->action == 'default' ? active"><a n:href="Homepage:default">{='HOME'|text|noescape}</a></li>
                                <li n:class="$presenter->action == 'aboutUs' ? active"><a n:href="Homepage:about-us">{='ABOUT_US'|text|noescape}</a></li>
                                {*<li n:class="$presenter->action == 'news' || $presenter->action == 'newsArticle' ? active"><a n:href="Homepage:news">{='NEWS'|text|noescape}</a></li>*}
                                <li n:class="$presenter->action == 'cleaningPlant' ? active"><a>{='OPERATIONS'|text|upper|noescape}</a>
                                    <ul class='sub-menu'>
                                        <li n:foreach='$cleaningPlants as $cleaningPlant'><a n:href="Homepage:cleaningPlant $cleaningPlant->url">{$cleaningPlant->name}</a></li>
                                    </ul>
                                <li n:class="$presenter->action == 'services' ? active"><a n:href="Homepage:services">{='SERVICES'|text|noescape}</a></li>
                                <li n:class="$presenter->action == 'equipment' ? active"><a n:href="Homepage:equipment">{='TECHNOLOGY'|text|noescape}</a></li>
                                <li n:class="$presenter->action == 'career' ? active"><a n:href="Homepage:career">{='CAREER'|text|noescape}</a></li>
                                <li n:if="$filesExists" n:class="$presenter->action == 'files' ? active"><a n:href="Homepage:files">{='DOWNLOADS'|text|noescape}</a></li>
                                <li n:class="$presenter->action == 'contact' ? active"><a n:href="Homepage:contact">{='CONTACT'|text|noescape}</a></li>
                            </ul>
                        </nav>

                        <div id="menu-toggle">
                            <div class="nav-icon">
                                <span></span><span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                </div>

                {ifset headerImage}
                    <h1>{ifset $title}{$title|nbsp|noescape}{elseifset h1}{include h1}{else}{include title|stripHtml}{/ifset}</h1>
                    {ifset headerImage}<img class="header-img" src="{include headerImage}" alt="{ifset headerImageAlt}{include headerImageAlt}{else}{='SITE_NAME'|text|noescape}{/ifset}">{/ifset}
                {else}
                    {dump isset($title)}
                    {if $presenter->name == 'Homepage' && $presenter->action == 'default'}
                        <h1>{='TITLE'|text|noescape}</h1>
                        <a class="arrow-down scroll" href="#about"></a>

                        <div class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                {foreach $slider as $slide}
                                    <div class="carousel-item {if $iterator->isFirst()}active{/if}">
                                        <h1>{$slide->title} <small>{$slide->text|striptags}</small></h1>
                                        <img class="d-block w-100" src="{$mainWebsiteUrl}/images/slider/{$micrositeId}/{$slide->id}.{$slide->image_extension}?v={$slide->image_version}" alt="{if $slide->title}{$slide->title}{else}{='SITE_NAME'|text|noescape}{/if}">
                                    </div>
                                {/foreach}
                            </div>
                        </div>
                    {elseif isset($title)}
                        <h1>{$title|nbsp|noescape}</h1>
                    {/if}
                {/ifset}
            </header>
            <!-- /header -->

            <main id="main">
                <div n:foreach="$flashes as $flash" class="alert {if $flash->type == 'success'}alert-success{elseif $flash->type == 'error'}alert-danger{else}alert-primary{/if} text-center"><i class="fa-solid {if $flash->type == 'success'}fa-circle-check{elseif $flash->type == 'error'}fa-circle-exclamation{else}fa-circle-info{/if}"></i>{$flash->message|noescape}</div>
                
                {include content}

                <section n:if="$presenter->action != 'messageSent'" id="kontakt">
                    <h2 class="h1">{='DEMAND'|text|noescape}</h2>

                    {form contactForm}
                        <div class="row row-cols-1 row-cols-sm-3">
                            <div class="col">
                                {input name}
                            </div>
                            <div class="col">
                                {input phone}
                            </div>
                            <div class="col">
                                {input email}
                            </div>
                        </div>
                        <div class="form-group">
                            {input message}
                        </div>
                        <div class="form-group">
                            <p>{='WE_PROCESS_PERSONAL_DATA'|text|noescape} <a n:href="Homepage:protectionOfPersonalData" target="_blank">{='HOW_WE_PROTECT_DATA'|text|noescape}</a></p>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-default">{='SEND_MESSAGE'|text}</button>
                        </div>
                    {/form}
                </section>
                
                <section n:if="$presenter->name == 'Homepage' && $presenter->action == 'default'" class="news">
                    <div class="container-fluid">
                        <h2 class="h1">{='CURRENTLY'|text|noescape}</h2>

                        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4">
                            {foreach $newsArticles as $article}
                                {breakIf $iterator->counter > 4}
                                {includeblock 'newsArticle.latte'}
                            {/foreach}
                        </div>

                        <div n:if="count($newsArticles) > 4" class="text-center">
                            <a class="btn btn-default" n:href="news">{='ALL_NEWS'|text|noescape}</a>
                        </div>
                    </div>
                </section>
            </main>

            <footer id="footer">
                <div class="container-fluid">
                    <a class="logo" href="/"><img src="../img/cei-member.svg" alt="logo - CE Industries"></a>

                    <p>
                        {$companyInfo->legal_name|noescape}, <br class="d-lg-none"> {$companyInfo->street|noescape},<br class="d-md-none"> {$companyInfo->city|noescape}<br><br class="d-lg-none">
                        {='PHONE_LABEL'|upper|text|noescape}: <a href="tel:{$companyInfo->phone|replace:'(+420) ':'+420'|replace:' ':''|noescape}">{$companyInfo->phone|noescape}</a> <span class="spacer d-md-inline-block">·</span><br class="d-md-none"> 
                        {='EMAIL_LABEL'|upper|text|noescape}: <a href="mailto:{$companyInfo->email|replace:'@':'&#64;'|noescape}">{$companyInfo->email|replace:'@':'&#64;'|noescape}</a> <span class="spacer">·</span><br class="d-md-none"><br class="d-lg-none">
                        {='ID_NUMBER_LABEL'|text|noescape}: {$companyInfo->id_number|noescape} <span class="spacer d-md-inline-block">·</span><br class="d-md-none"> 
                        {='VAT_ID_LABEL'|text|noescape}: {$companyInfo->vat_id|noescape}
                    </p>

                    <hr>

                    <p>
                        <a n:href="Homepage:protectionOfPersonalData">{='PRIVACY'|text|noescape}</a>
                    </p>
                </div>
            </footer>

        </div>
        <!-- /wrapper --> 

        <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
        <script src="{='js/cookieconsent.js'|autoVersion}"></script>
        <script src="{='js/main.js'|autoVersion}"></script>
        <!-- MIU -->
        <script src="{$basePath}/js/news-slider.js"></script>
    </body>
</html>