{block bodyClass}hp{/block}

{block content}

{* --- DYNAMICKÉ AKTUALITY (Z DATABÁZE) --- *}
<section id="aktuality-figma" style="padding: 80px 0; background-color: #ffffff;">
    <div class="container text-center">
        <h2 style="font-weight: 200; font-size: 3rem; color: #333; margin-bottom: 60px; text-align: center;">aktuálně</h2>
        
        <div class="row align-items-center text-start">
            
            {* Textová část vlevo *}
            <div class="col-md-6">
                <div id="news-slider">
                    {foreach $news as $item}
                        <div class="news-item" style="display: {if $iterator->first}block{else}none{/if};" data-index="{$iterator->counter0}">
                            <span style="color: #f8c400; font-weight: bold; font-size: 1.2rem; display: block; text-transform: uppercase;">
                                {$item->date|date:'d/m/y'}
                            </span>
                            <div style="width: 60px; height: 3px; background-color: #f8c400; margin: 15px 0 25px 0;"></div>
                            <h2 style="color: #003366; font-size: 3rem; font-weight: 800; line-height: 1.1; margin-bottom: 20px;">
                                {$item->title}
                            </h2>
                            <p style="color: #666; font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px; max-width: 500px;">
                                {$item->perex|noescape}
                            </p>
                        </div>
                    {/foreach}
                </div>

                {* Navigace šipkami *}
                <div style="display: flex; gap: 20px; align-items: center;">
                    <div id="prev-news" style="cursor: pointer; font-size: 2.5rem; color: #003366; font-weight: bold; user-select: none;">&lsaquo;</div>
                    <div id="next-news" style="cursor: pointer; font-size: 2.5rem; color: #003366; font-weight: bold; user-select: none;">&rsaquo;</div>
                </div>
            </div>

            {* Kruhový obrázek vpravo *}
            <div class="col-md-6 d-none d-md-flex justify-content-end">
                <div style="width: 450px; height: 450px; border-radius: 50%; overflow: hidden; border: 1px solid #eee; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                    {foreach $news as $item}
                        <img class="news-img" src="{$item->image|imagePath}" 
                             style="width: 100%; height: 100%; object-fit: cover; display: {if $iterator->first}block{else}none{/if};" 
                             data-index="{$iterator->counter0}">
                    {/foreach}
                </div>
            </div>
        </div>
    </div>
</section>

{* --- SEKCE O FIRMĚ --- *}
<section id="about">
    <div class="row row-cols-1 row-cols-sm-2 g-0 content">
        <div class="col">
            <img src="{='ABOUT_COMPANY'|imagePath}" alt="CEI">
        </div>
        <div class="col">
            <div class="text-block">
                <h3>{='ABOUT_COMPANY'|text|noescape}</h3>
                {='ABOUT_COMPANY_TEXT'|text|noescape}
