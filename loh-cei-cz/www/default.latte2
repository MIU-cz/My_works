            </div>
        </div>
    </div>

    <div class="stats">
        <h2 class="h1">{='HOMEPAGE_TITLE'|text|lower|noescape}</h2>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-0 mb-4 justify-content-center" style="display: flex; flex-wrap: wrap;">
            <div class="col">
                <a n:href="Homepage:services#service-37">
                    <div class="icon"><img src="/img/icons/hospodarstvi.svg" height="51" alt=""></div>
                    <strong>{='COMPREHENSIVE_WASTE_MANAGEMENT'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-38">
                    <div class="icon"><img src="/img/icons/ochrana.svg" height="52" alt=""></div>
                    <strong>{='CONSULTING_FOR_THE_PROTECTION_OF_THE_ENVIRONMENT'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-39">
                    <div class="icon"><img src="/img/icons/odstraneni.svg" height="52" alt=""></div>
                    <strong>{='REMOVAL_OF_HAZARDOUS_AND_OTHER_WASTE'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-40">
                    <div class="icon"><img src="/img/icons/cisteni.svg" height="55" alt=""></div>
                    <strong>{='CLEANING_OF_SEWERS_AND_SUMPS'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-41">
                    <div class="icon"><img src="/img/icons/monitoring.svg" height="52" alt=""></div>
                    <strong>{='PIPELINE_MONITORING'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-42">
                    <div class="icon"><img src="/img/icons/doprava.svg" height="47" alt=""></div>
                    <strong>{='WASTE_REMOVAL_AND_ADR_TRANSPORT'|text|noescape}</strong>
                </a>
            </div>
            <div class="col">
                <a n:href="Homepage:services#service-43">
                    <div class="icon"><img src="/img/icons/kontejnery.svg" height="55" alt=""></div>
                    <strong>{='IBC_CONTAINERS'|text|noescape}</strong>
                </a>
            </div>
        </div>
        <a class="btn btn-default" n:href="Homepage:services">{='I_WANT_TO_KNOW_MORE'|text|lower|noescape}</a>
    </div>
</section>

<section id="">
    <div class="row row-cols-1 row-cols-sm-2 g-0 content">
        <div class="col order-sm-2">
            <img src="{='HOMEPAGE_INTRODUCTION'|imagePath}" alt="CEI">
        </div>
        <div class="col order-sm-1 bg-gray">
            <div class="text-block">
                {='INTRODUCTION'|text|noescape}
            </div>
        </div>
    </div>
    <div class="stats">
        <div class="container-fluid">
            <h2 class="h1">{='WHAT_WE_OFFER'|text|lower|noescape}</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-0 mb-4 justify-content-center">
                {='WHAT_WE_OFFER_HTML'|text|noescape}
            </div>
            <a class="btn btn-default" n:href="Homepage:services">{='I_WANT_TO_KNOW_MORE'|text|lower|noescape}</a>
        </div>
    </div>
</section>

{syntax off}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let currentIdx = 0;
    const items = document.querySelectorAll('.news-item');
    const images = document.querySelectorAll('.news-img');
    const total = items.length;

    if (total === 0) return;

    function show(index) {
        items.forEach(el => el.style.display = 'none');
        images.forEach(el => el.style.display = 'none');
        
        currentIdx = (index + total) % total;
        
        document.querySelector(`.news-item[data-index="${currentIdx}"]`).style.display = 'block';
        document.querySelector(`.news-img[data-index="${currentIdx}"]`).style.display = 'block';
    }

    document.getElementById('next-news').onclick = () => show(currentIdx + 1);
    document.getElementById('prev-news').onclick = () => show(currentIdx - 1);
});
</script>
{/syntax}
{/block}